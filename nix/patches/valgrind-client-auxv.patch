From de9c4730516522bbc02b55caf4c4df376dd0f169 Mon Sep 17 00:00:00 2001
From: Petar Jovanovic <mips32r2@gmail.com>
Date: Sun, 8 Nov 2026 02:07:32 +0000
Subject: Linux syswrap: return client auxv for PR_GET_AUXV

prctl(PR_GET_AUXV) passed through to the kernel and returned the
tool's auxv. uutils coreutils reads AT_EXECFN this way, so it failed
under Valgrind with "unknown program 'memcheck-amd64-linux'".

Hand out the fake /proc/self/auxv instead and add a regression test.

This fixes KDE #528086.
Source: https://sourceware.org/cgit/valgrind/commit/?id=de9c4730516522bbc02b55caf4c4df376dd0f169

Only the runtime hunks are needed for the nixpkgs release tarball.

diff --git a/coregrind/m_syswrap/syswrap-linux.c b/coregrind/m_syswrap/syswrap-linux.c
index d6563c0a66..e5df521837 100644
--- a/coregrind/m_syswrap/syswrap-linux.c
+++ b/coregrind/m_syswrap/syswrap-linux.c
@@ -1584,6 +1584,33 @@ PRE(sys_prctl)
    case VKI_PR_CAPBSET_DROP:
       PRE_REG_READ2(int, "prctl", int, option, int, capability);
       break;
+   case VKI_PR_GET_AUXV: {
+      /* Like /proc/self/auxv, return the client's auxv, not the tool's. */
+      PRE_REG_READ5(int, "prctl", int, option, void *, auxv,
+                    unsigned long, size, unsigned long, arg4,
+                    unsigned long, arg5);
+      *flags &= ~SfMayBlock;
+      SysRes res = VG_(do_syscall5)(__NR_prctl, VKI_PR_GET_AUXV, 0, 0,
+                                    ARG4, ARG5);
+      if (sr_isError(res)) {
+         SET_STATUS_from_SysRes(res);
+         break;
+      }
+      Long auxv_size = VG_(fsize)(VG_(cl_auxv_fd));
+      vg_assert(auxv_size > 0);
+      SizeT len = VG_MIN((SizeT)ARG3, (SizeT)auxv_size);
+      if (len > 0) {
+         PRE_MEM_WRITE("prctl(get-auxv)", ARG2, len);
+         res = VG_(pread)(VG_(cl_auxv_fd), (void *)(Addr)ARG2, len, 0);
+         if (sr_isError(res) || sr_Res(res) != len) {
+            SET_STATUS_Failure(VKI_EFAULT);
+            break;
+         }
+         POST_MEM_WRITE(ARG2, len);
+      }
+      SET_STATUS_Success(auxv_size);
+      break;
+   }
    default:
       PRE_REG_READ5(long, "prctl",
                     int, option, unsigned long, arg2, unsigned long, arg3,
diff --git a/include/vki/vki-linux.h b/include/vki/vki-linux.h
index 2010ffc12b..c72db6774a 100644
--- a/include/vki/vki-linux.h
+++ b/include/vki/vki-linux.h
@@ -2804,6 +2804,8 @@ struct vki_vt_consize {
 #define VKI_PR_SET_TAGGED_ADDR_CTRL	55
 #define VKI_PR_GET_TAGGED_ADDR_CTRL	56
 
+#define VKI_PR_GET_AUXV			0x41555856
+
 //----------------------------------------------------------------------
 // From linux-2.6.19/include/linux/usbdevice_fs.h
 //----------------------------------------------------------------------
